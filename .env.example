# Resend API key — create one at https://resend.com/api-keys
# Server-side only. NEVER prefix with NEXT_PUBLIC_ and never expose to the client.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Where contact-form submissions are delivered.
CONTACT_TO=hello@niksar.dev

# Verified sender address (must be on a domain verified in Resend).
# Until you verify a domain you can use Resend's sandbox: onboarding@resend.dev
CONTACT_FROM=Niksar <onboarding@resend.dev>
